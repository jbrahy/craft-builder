[Unit]
Description=craft build: build the queue craft-web sent (/srv/craft/queue.tsv)

[Service]
Type=oneshot
User=builder
Group=craft
Environment=HOME=/srv/craft/home/builder
Environment=RUSTUP_HOME=/srv/craft/toolchain/rustup
Environment=CARGO_HOME=/srv/craft/toolchain/cargo
# LLVM 19 first: the MSVC STL headers from xwin reject clang older than 19.
Environment=PATH=/usr/local/lib/craft-llvm/bin:/usr/lib/llvm-19/bin:/srv/craft/toolchain/cargo/bin:/usr/local/bin:/usr/bin:/bin
Environment=CARGO_BUILD_JOBS=8
# sqlx query macros: use the repo's .sqlx cache instead of a live database.
Environment=SQLX_OFFLINE=true
# Accepts the Microsoft Windows SDK/CRT license (approved 2026-10-08).
Environment=XWIN_ACCEPT_LICENSE=1
Environment=XWIN_CACHE_DIR=/srv/craft/toolchain/xwin
ExecStart=/opt/craft-builder/bin/build.sh
TimeoutStartSec=12h
Nice=10
# Group-writable output so "driver" can clean it after craft-web fetches it.
UMask=0002
# Builds run unreviewed upstream code: no privileges, writes only to /srv/craft.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/craft
